+// SRSRAN.UeCqi
+bool e2sm_kpm_du_meas_provider_impl::get_ue_cqi(const asn1::e2sm::label_info_list_l          label_info_list,
+                                                 const std::vector<asn1::e2sm::ue_id_c>&      ues,
+                                                 const std::optional<asn1::e2sm::cgi_c>       cell_global_id,
+                                                 std::vector<asn1::e2sm::meas_record_item_c>& items)
+{
+  return get_ue_scheduler_value(
+      ues, items, true, [](const scheduler_ue_metrics& m) -> std::optional<double> { return m.cqi_stats.get_nof_observations() > 0 ? std::optional<double>(std::round(m.cqi_stats.get_mean())) : std::nullopt; });
+}
