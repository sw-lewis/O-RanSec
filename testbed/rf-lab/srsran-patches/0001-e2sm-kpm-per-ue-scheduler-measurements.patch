+// ---- Per-UE scheduler measurements (srsRAN extension) ----
+
+bool e2sm_kpm_du_meas_provider_impl::get_ue_scheduler_value(const std::vector<asn1::e2sm::ue_id_c>&      ues,
+                                                            std::vector<asn1::e2sm::meas_record_item_c>& items,
+                                                            bool                                         as_integer,
+                                                            ue_value_func_t                              value)
+{
+  // Node-level request (no UE list): these measurements exist per UE only.
+  if (ues.empty()) {
+    meas_record_item_c meas_record_item;
+    meas_record_item.set_no_value();
+    items.push_back(meas_record_item);
+    return true;
+  }
+  for (const auto& ue : ues) {
+    meas_record_item_c  meas_record_item;
+    gnb_cu_ue_f1ap_id_t gnb_cu_ue_f1ap_id = int_to_gnb_cu_ue_f1ap_id(ue.gnb_du_ue_id().gnb_cu_ue_f1ap_id);
+    du_ue_index_t       ue_idx            = f1ap_ue_id_provider.get_ue_index(gnb_cu_ue_f1ap_id);
+    auto                it = std::find_if(last_ue_metrics.begin(), last_ue_metrics.end(), [ue_idx](const scheduler_ue_metrics& m) {
+      return m.ue_index == ue_idx;
+    });
+    std::optional<double> v;
+    if (ue_idx != du_ue_index_t::INVALID_DU_UE_INDEX and it != last_ue_metrics.end()) {
+      v = value(*it);
+    }
+    if (not v.has_value()) {
+      meas_record_item.set_no_value();
+    } else if (as_integer) {
+      meas_record_item.set_integer() = static_cast<uint64_t>(std::max(0.0, std::round(*v)));
+    } else {
+      meas_record_item.set_real();
+      meas_record_item.real().value = *v;
+    }
+    items.push_back(meas_record_item);
+  }
+  return true;
+}
